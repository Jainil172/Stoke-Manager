# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (localhost:5173 is always allowed)
CLIENT_URL=http://localhost:5173

# Auth - use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_string
# How long login sessions last (e.g. 7d, 30d, 1y). Users stay signed in for this long.
JWT_EXPIRES_IN=30d

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stockflow
